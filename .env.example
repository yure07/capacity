# Copie para .env (local) ou cadastre na hospedagem. Não coloque segredos neste arquivo.

# Supabase → Project Settings → API (valores públicos por natureza; o acesso é limitado pelo RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública da aplicação, usada nos links de validação e QR Codes.
# Produção: o domínio real com https (ex.: https://certificados.suaempresa.com.br).
# Local: http://localhost:3000
APP_URL=

# NÃO usar: a service_role / secret key não é necessária e nunca deve ir para o projeto.
